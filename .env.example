# Copy this file to .env (same folder as this file's parent) and fill in
# per environment. .env is never committed — config/env.php reads it and
# every default below matches the previous hardcoded XAMPP values, so an
# app with no .env at all still boots exactly as before.

# ---- App ----
# XAMPP:            http://localhost/acme-ats
# Cloudflare Tunnel: https://xxxx.trycloudflare.com   (update after each `cloudflared tunnel run`)
# InfinityFree:      https://yourdomain.infinityfreeapp.com
APP_URL=http://localhost/acme-ats
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=acme_ats
DB_USER=root
DB_PASS=

# ---- Resend (email) ----
# Leave RESEND_API_KEY blank to keep email sending disabled — the app logs
# what it would have sent to storage/logs/mail.log instead of failing.
RESEND_API_KEY=
RESEND_FROM=no-reply@example.com
RESEND_FROM_NAME=Acme ATS

# ---- PDF job description import ----
# Path to a Python interpreter with pdfplumber (or PyMuPDF) installed, used by
# tools/extract_job_data.py. Leave blank to auto-detect: tools/.venv first, then
# python3/python/py on PATH. If no interpreter is found -- shared hosting
# usually has none, and often disables proc_open -- the importer falls back to
# the bundled PHP reader (includes/pdf_extract.php) and still works.
JD_PYTHON_BIN=
